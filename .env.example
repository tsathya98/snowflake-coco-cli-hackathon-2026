# Warrant — example environment. Copy to .env (gitignored) and fill in.
# NOTE: Snowflake credentials do NOT belong here. They live in
# ~/.snowflake/connections.toml and are read by both `snow` and `cortex`.

# Name of the connection in ~/.snowflake/connections.toml
WARRANT_CONNECTION=warrant

# Target objects
WARRANT_DATABASE=WARRANT
WARRANT_WAREHOUSE=WARRANT_WH

# Optional: Slack webhook secret name for escalation notifications
# (created as a Snowflake SECRET, referenced by name — not the URL itself)
WARRANT_SLACK_SECRET_NAME=
